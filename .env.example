# ============================================================================
# SPARKEEFY WAITLIST - ENVIRONMENT VARIABLES
# ============================================================================
# Quick start: cp .env.example .env && docker-compose up -d && npm run dev
# (This .env matches docker-compose.yml Postgres; copy to .env and run.)
# Never commit .env to version control!

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Environment: development | production | test
NODE_ENV=development

# Server port (1-65535)
PORT=4000

# ============================================================================
# DATABASE CONFIGURATION (matches docker-compose.yml)
# ============================================================================
# Start Postgres: docker-compose up -d

DATABASE_URL="postgresql://sparkeefy:sparkeefy123@localhost:5432/sparkeefy_waitlist"

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend application URL (for CORS and referral links)
FRONTEND_URL="http://localhost:5173"

# Backend API for Next.js tRPC client. Use one of:
# - NEXT_PUBLIC_API_URL = full URL (e.g. https://api.example.com/trpc) for production
# - NEXT_PUBLIC_API_PORT = port only for local dev (default 4000); base URL is http://localhost:PORT/trpc
NEXT_PUBLIC_API_PORT=4000
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com/trpc

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated or * for all)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:4000"
